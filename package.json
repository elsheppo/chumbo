{
  "name": "chumbo",
  "version": "0.10.2",
  "description": "MCP made easy on Supabase.",
  "type": "module",
  "license": "MIT",
  "author": "Shep Bryan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elsheppo/chumbo.git"
  },
  "homepage": "https://github.com/elsheppo/chumbo#readme",
  "bugs": {
    "url": "https://github.com/elsheppo/chumbo/issues"
  },
  "keywords": [
    "supabase",
    "mcp",
    "model-context-protocol",
    "edge-functions",
    "oauth",
    "rls",
    "mcp-server"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "chumbo": "dist/cli.js",
    "supa-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run release:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:packed && pnpm run test:generated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reference:app": "vite build --config supabase/functions/review-queue-app/app/vite.config.ts",
    "reference:consent": "node scripts/build-reference-consent.mjs",
    "reference:content": "node scripts/sync-reference-content.mjs",
    "reference:check": "node scripts/reference-check.mjs",
    "reference:hosted": "node scripts/hosted-reference-smoke.mjs",
    "release:check": "node scripts/release-alignment-check.mjs",
    "test": "vitest run",
    "test:generated": "node scripts/generated-smoke.mjs",
    "test:packed": "node scripts/packed-artifact-smoke.mjs",
    "test:rls": "node scripts/rls-integration-check.mjs",
    "test:state-integration": "node scripts/state-integration-check.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/server": "1.4.1",
    "@supabase/supabase-js": "2.105.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "jose": "6.2.8",
    "prettier": "3.8.1",
    "tsdown": "0.20.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.0"
  },
  "packageManager": "pnpm@10.11.0"
}
